rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Phase 4.2 Validation Blueprint
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'phoneNumber', 'createdAt']) && data.keys().size() == 3
          && data.uid is string && data.uid.size() <= 128
          && data.phoneNumber is string && data.phoneNumber.size() <= 32
          && data.createdAt is number;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(userId) 
                    && request.auth.uid == userId 
                    && incoming().uid == request.auth.uid
                    && isValidUser(incoming())
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && isValidId(userId)
                    && request.auth.uid == userId
                    && existing().uid == request.auth.uid
                    && isValidUser(incoming())
                    && incoming().uid == existing().uid
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['phoneNumber']);
      allow delete: if false; // No deletion without admin
    }
  }
}
